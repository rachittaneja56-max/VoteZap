PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/votezap
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_access_secret
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret
GOOGLE_CLIENT_ID=your_google_id
CUSTOM_IDP_URL=https://auth.rachittaneja.in
CUSTOM_IDP_CLIENT_ID=your_custom_client_id
CUSTOM_IDP_CLIENT_SECRET=your_custom_client_secret
CUSTOM_IDP_REDIRECT_URI=http://localhost:5173/auth/callback
